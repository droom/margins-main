<!DOCTYPE html>
<html lang="en">
   <head>
      <!-- @import "partials/_head" -->
   </head>
   <body>
      <div class="container">


         <div class="page">
            <div class="grid-main">
               <div class="hero grid-16">
                  <small>MARGINS&copy;</small>
                  <small class="project">Frendsbury Community Garden</small>
                  <small class="studio">Studio</small>
               </div>
               <div class="hero hivstory grid-16">
                  <h3 class="intro"><em>Once a wasteland, now reclaimed by local residents, Frendsbury Community Gardens is an idil beneath the train-tracks in South-East London.</em></h3>
                  <div id="stickers">
                     <div class="sticker sticker-2">
                        <div class="sticker-container">
                           <div class="sticker-wrapper">
                              <div class="sticker-clip">
                                 <div class="sticker-front flex">
                                    <p>VIEW</p>
                                 </div>
                                 <div class="sticker-back"></div>
                              </div>
                           </div>
                        </div>
                     </div>
                     <div class="sticker sticker-4">
                        <div class="sticker-container">
                           <div class="sticker-wrapper">
                              <div class="sticker-clip">
                                 <div class="sticker-front"></div>
                                 <div class="sticker-back"></div>
                              </div>
                           </div>
                        </div>
                     </div>
                     <div class="sticker sticker-6">
                        <div class="sticker-container">
                           <div class="sticker-wrapper">
                              <div class="sticker-clip">
                                 <div class="sticker-front"></div>
                                 <div class="sticker-back"></div>
                              </div>
                           </div>
                        </div>
                     </div>
                  </div>
               </div>
            </div>
         </div>
         <div class="page">
            <div class="grid-main">
               <div class="links top grid-16">
                  <small class="home"><strong>MARGINS&copy;</strong></small>
                  <small class="project">HIVStory</small>
                  <small class="studio">Studio</small>
               </div>
               <div class="hero hivstory grid-16 rows">
                  <h3 class="intro"><em>Incredible, real stories of love, life &amp; loss.</em> <span class="sc">UK</span>-wide outreach raising awareness and understanding of the history of <span class="sc">HIV</span> and <span class="sc">AIDS</span>.</h3>
                  <div class="grid-img-A"></div>
                  <div class="grid-img-B"></div>
                  <!-- <img class="max grid-img-1" src="img/hivstory-01.png"/> -->
                  <!-- <img class="max grid-img-2" src="img/hivstory-02.png"/> -->
                  <a href="#" class="cta sans">View</a>
               </div>
               <div class="links">
                  <small class="flat"></small>
               </div>
            </div>
         </div>
         <div class="page">
            <div class="grid-main">
               <div class="links top grid-16">
                  <small class="project">South Norwood Community Kitchen</small>
               </div>
               <div class="hero snck grid-16 rows">
                  <small><strong>MARGINS&copy;</strong></small>
                  <small><strong class="hideme">MARGINS&copy;</strong></small>
                  <h3 class="intro">An open access, cooperative community space where everyone is welcomed 5 days per week.</h3>
                  <img class="max grid-img-1" src="img/snck-01.png"/>
                  <!-- <img class="max" src="img/snck-02.png"/> -->
                  <!-- <img class="max" src="img/snck-03.png"/> -->
                  <!-- <img class="max" src="img/snck-04.svg"/> -->
               </div>
               <div class="links">
                  <small class="flat"></small>
               </div>
            </div>
         </div>
      </div>
